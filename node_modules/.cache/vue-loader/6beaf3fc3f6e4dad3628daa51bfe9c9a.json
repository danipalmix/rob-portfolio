{"remainingRequest":"/Users/vincenzo/Effingo/website/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/vincenzo/Effingo/website/src/components/SocialHomeCard.vue?vue&type=style&index=0&id=3ba6bb4c&scoped=true&lang=css","dependencies":[{"path":"/Users/vincenzo/Effingo/website/src/components/SocialHomeCard.vue","mtime":1740835891752},{"path":"/Users/vincenzo/Effingo/website/node_modules/css-loader/dist/cjs.js","mtime":1740835932650},{"path":"/Users/vincenzo/Effingo/website/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1740835923854},{"path":"/Users/vincenzo/Effingo/website/node_modules/postcss-loader/src/index.js","mtime":1740835923396},{"path":"/Users/vincenzo/Effingo/website/node_modules/cache-loader/dist/cjs.js","mtime":1740835932768},{"path":"/Users/vincenzo/Effingo/website/node_modules/vue-loader/lib/index.js","mtime":1740835923805}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["SocialHomeCard.vue"],"names":[],"mappings":";AAwBA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA","file":"SocialHomeCard.vue","sourceRoot":"src/components","sourcesContent":["<template>\n  <div id=\"social-home-card-container\">\n    <b-row>\n      <b-col id=\"dark-div\" class=\"col\" sm=\"6\" md=\"6\" lg=\"6\" xl=\"3\">\n        <h1 id=\"main-text\"> GESTIONE SOCIAL </h1>\n        <h1> FACEBOOK </h1>\n        <h1> INSTAGRAM </h1>\n        <h1> GOOGLE </h1>\n      </b-col>\n      <b-col id=\"light-div\" class=\"col\" sm=\"6\" md=\"6\" lg=\"6\" xl=\"9\">\n        <h4>Creazione e Ottimizzazione</h4>\n        <p>Creazione e ottimizzazione di pagine social anche gia’ esistenti.</p>\n        <p>Le&nbsp;<strong>pagine social</strong> sono ormai un mezzo di pubblicita’ e di grande impatto sia in fatto di\n          immagine che di incremento di fatturato, sia a breve che a lungo termine.</p>\n        <p>La gestione della pagina social deve garantire un vantaggio e attivare un tam tam di passaparola on line.<br>\n          Per questo mettiamo a vostra disposizione la nostra esperienza per ottimizzare le vostre pagine aziendali,\n          Facebook, Instagram, incrementando le visite al vostro sito otterrete piu’ visibilita’ e conseguente\n          incremento di Clienti e fatturato.</p>\n      </b-col>\n    </b-row>\n  </div>\n</template>\n\n<style scoped>\n#social-home-card-container {\n  color: white;\n  margin-top: 6%;\n}\n\n#dark-div {\n  border-radius: 25px 0 0 25px;\n  background-color: #2a2c2e;\n}\n\n#light-div {\n  border-radius: 0 25px 25px 0;\n  background-color: #10bccd;\n}\n\n.col {\n  padding: 5%;\n}\n\n#main-text {\n  color: #10bccd;\n}\n\n@media only screen and (max-width: 600px) {\n  .col {\n    padding: 8%;\n  }\n}\n\n</style>"]}]}