ssions that bring your digital persona to life.\n      </p>\n      <!-- Horizontal Rule with the same gradient style -->\n      <hr class=\"hero-hr\" />\n    </div>\n  </section>\n</template>\n\n<style scoped>\n.hero-section {\n  position: relative;\n  width: 100%;\n  height: 100vh; /* Full viewport height */\n  overflow: hidden;\n  border-radius: 0px 0px 25px 25px;\n  margin-bottom: 6%;\n  /* Flex positioning for the overlay content */\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end; /* Push content to the bottom */\n  align-items: center;\n}\n\n.hero-video {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.hero-content {\n  z-index: 1;\n  max-width: 80%;\n  text-align: center;\n  color: #ffffff;\n  padding-bottom: 5%;\n}\n\n.hero-title {\n  font-size: 4rem;\n  margin-bottom: 1rem;\n  font-weight: bold;\n  /* Top-to-bottom gradient that fades to transparent */\n  background: linear-gradient(180deg, #f8f8ff, rgba(248, 248, 255, 0.53));\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  background-clip: text;\n  color: transparent;\n}\n\n.hero-description {\n  font-size: 1.2rem;\n  margin-bottom: 2rem;\n  line-height: 1.4;\n}\n\n/* HR element with the same gradient style as the title */\n.hero-hr {\n  border: none;\n  height: 4px;\n  width: 50%;\n  background: linear-gradient(180deg, #f8f8ff, rgba(248, 248, 255, 0.53));\n  margin: 1rem auto 0;\n}\n\n/* Responsive Styling */\n@media (max-width: 768px) {\n  .hero-title {\n    font-size: 2.5rem;\n  }\n  .hero-description {\n    font-size: 1rem;\n  }\n  .hero-content {\n    max-width: 90%;\n    padding-bottom: 3%;\n  }\n  .hero-hr {\n    width: 60%;\n  }\n}\n\n@media (max-width: 480px) {\n  .hero-title {\n    font-size: 2rem;\n  }\n  .hero-description {\n    font-size: 0.9rem;\n  }\n  .hero-hr {\n    width: 70%;\n  }\n}\n</style>\n"],"names":[],"mappings":";;;AAAc;AACd,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CA