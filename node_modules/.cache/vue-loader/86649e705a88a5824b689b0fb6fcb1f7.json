{"remainingRequest":"/Users/vincenzo/Effingo/website/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/vincenzo/Effingo/website/src/components/rob-portfolio.vue?vue&type=style&index=0&id=60561360&scoped=scss&lang=css","dependencies":[{"path":"/Users/vincenzo/Effingo/website/src/components/rob-portfolio.vue","mtime":1755774772498},{"path":"/Users/vincenzo/Effingo/website/node_modules/css-loader/dist/cjs.js","mtime":1740835932650},{"path":"/Users/vincenzo/Effingo/website/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1740835923854},{"path":"/Users/vincenzo/Effingo/website/node_modules/postcss-loader/src/index.js","mtime":1740835923396},{"path":"/Users/vincenzo/Effingo/website/node_modules/cache-loader/dist/cjs.js","mtime":1740835932768},{"path":"/Users/vincenzo/Effingo/website/node_modules/vue-loader/lib/index.js","mtime":1740835923805}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["rob-portfolio.vue"],"names":[],"mappings":";;AAsRA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"rob-portfolio.vue","sourceRoot":"src/components","sourcesContent":["<template>\n  <div class=\"portfolio-container\">\n    <header>\n      <button class=\"menu-button\" @click=\"toggleNav\">\n        <img src=\"../assets/hamburger.png\" alt=\"Menu\" />\n      </button>\n      <img src=\"../assets/Logo_rob.png\" alt=\"Logo Roberta\" class=\"logo\" />\n    </header>\n\n    <aside :class=\"['sidenav', { 'is-open': navOpen }]\">\n      <button class=\"close-btn\" @click=\"toggleNav\">&times;</button>\n      <nav>\n        <ul>\n          <li><a href=\"#\" @click=\"changePage('portfolio')\">Portfolio</a></li>\n          <li><a href=\"#\" @click=\"changePage('about')\">About Me</a></li>\n          <li><a href=\"#\" @click=\"changePage('contact')\">Contact Me</a></li>\n        </ul>\n      </nav>\n      <div class=\"social-buttons\">\n        <a href=\"#\"><v-icon>mdi-pinterest</v-icon></a>\n        <a href=\"#\"><v-icon>mdi-instagram</v-icon></a>\n        <a href=\"#\"><v-icon>mdi-facebook</v-icon></a>\n        <a href=\"#\"><v-icon>mdi-twitter</v-icon></a>\n      </div>\n    </aside>\n\n    <div :class=\"['main-content-wrapper', { 'shifted': navOpen }]\">\n\n      <section v-if=\"currentPage === 'portfolio'\" class=\"portfolio-section\">\n        <div class=\"filter-bar\">\n          <button v-if=\"parentFilter\" @click=\"goBack\" class=\"back-button\">\n            <span class=\"back-arrow\">&larr;</span> {{ parentFilter.name }}\n          </button>\n          <button v-for=\"filter in currentFilters\" :key=\"filter.id\" @click=\"selectFilter(filter)\" :class=\"{ active: activeFilter.id === filter.id }\">\n            {{ filter.name }}\n          </button>\n        </div>\n        <main class=\"masonry-grid\">\n          <div class=\"masonry-item\" v-for=\"(image, index) in filteredImages\" :key=\"index\" @click=\"openLightbox(image.src)\">\n            <div class=\"image-wrapper\">\n              <img :src=\"image.src\" :alt=\"image.alt\" loading=\"lazy\" @load=\"image.loaded = true\" :class=\"{ loaded: image.loaded }\" />\n              <div class=\"overlay\">\n                <span>{{ image.alt }}</span>\n              </div>\n            </div>\n          </div>\n        </main>\n      </section>\n\n      <section v-if=\"currentPage === 'about'\" class=\"about-container\">\n        <h1 class=\"page-title\">About Me</h1>\n        <div class=\"about-content\">\n          <div class=\"about-intro-grid\">\n            <div class=\"intro-image-wrapper\">\n              <img src=\"https://picsum.photos/seed/roberta/400/500?grayscale\" alt=\"Roberta, a.k.a. RoPhil\" class=\"profile-photo\"/>\n            </div>\n            <div class=\"intro-text-wrapper\">\n              <h2 class=\"section-title\">My name is Roberta, also known as RoPhil.</h2>\n              <p>I was born in 1995 and live in Italy. My passion for art didn’t begin at a specific moment—it has always been a part of me. As a child, I started drawing and simply never stopped. Growing up self-taught, I never doubted my love for art, though the journey to finding my path wasn’t always straightforward.</p>\n            </div>\n          </div>\n\n          <div class=\"about-section\">\n            <h2 class=\"section-title\">The Journey</h2>\n            <p>Over time, I explored different creative forms. During my school years, I attended a graphic design institute, where I also developed an interest in photography. Each photograph was just the beginning: in my mind, lines and shadows came to life as naturally as breathing. Later, I ventured into tattooing, experimenting with new techniques. Yet, the strongest pull remained the freedom of drawing—the kind that flows spontaneously onto the page, without boundaries.</p>\n            <p>A new chapter began with my first iPad. It was the early days of NFTs, a time that inspired me to create not only images but also stories, characters, and worlds. Through various explorations, I grew closer to animation, seeking to give broader life and movement to my imagination.</p>\n          </div>\n          <div class=\"about-section about-curiosity\">\n            <h2 class=\"section-title\">Curiosity and Inspiration</h2>\n            <p>Today, I love moving between different creative disciplines and nurturing my curiosity: illustration, graphic design, logo and icon creation, along with small personal experiments in 3D art.</p>\n            <p>Nature remains one of my greatest inspirations, but I often let my instinct guide me—a simple ink blot can suggest shapes and stories, like a playful game of pareidolia. I like observing the world slowly, marveling at simple things, drawing inspiration from a detail, a fragment... or even from my cats, who often, unknowingly, become my best references.</p>\n          </div>\n          <div class=\"about-section about-cta\">\n            <h2 class=\"section-title\">Let's Create Together</h2>\n            <p>My goal is to keep refining my style, expanding my technical skills day by day, and strengthening my artistic voice. If you have an idea you’d like to bring to life with me, feel free to share it by filling out a short questionnaire. Whether it’s an illustration, a logo, or a character design, each project will be a journey built with care.</p>\n            <button class=\"cta-button\">Fill out the Questionnaire</button>\n          </div>\n          <div class=\"about-quote\">\n            <p>\"Art is my way of telling the world’s stories—and I know I’ll never stop.\"</p>\n          </div>\n        </div>\n      </section>\n\n      <section v-if=\"currentPage === 'contact'\" class=\"contact-container\">\n        <h1 class=\"page-title\">Let's Get in Touch</h1>\n        <div class=\"contact-content\">\n          <p class=\"contact-intro\">Whether you have a project in mind, a collaboration proposal, or just want to say hi, I'd love to hear from you. Fill out the form below or find me on my social networks.</p>\n\n          <form class=\"contact-form\" @submit.prevent=\"submitForm\">\n            <div class=\"form-group\">\n              <label for=\"name\">Name</label>\n              <input type=\"text\" id=\"name\" name=\"name\" required>\n            </div>\n            <div class=\"form-group\">\n              <label for=\"email\">Email</label>\n              <input type=\"email\" id=\"email\" name=\"email\" required>\n            </div>\n            <div class=\"form-group\">\n              <label for=\"message\">Message</label>\n              <textarea id=\"message\" name=\"message\" rows=\"6\" required></textarea>\n            </div>\n            <button type=\"submit\" class=\"cta-button\">Send Message</button>\n          </form>\n\n          <div class=\"social-contact\">\n            <h2>Find me here too!</h2>\n            <div class=\"social-icons\">\n              <a href=\"#\" class=\"social-link\"><v-icon>mdi-pinterest</v-icon></a>\n              <a href=\"#\" class=\"social-link\"><v-icon>mdi-instagram</v-icon></a>\n              <a href=\"#\" class=\"social-link\"><v-icon>mdi-facebook</v-icon></a>\n              <a href=\"#\" class=\"social-link\"><v-icon>mdi-twitter</v-icon></a>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <footer>\n        <p>&copy; 2025 Portfolio Roberta</p>\n      </footer>\n    </div>\n\n    <div v-if=\"lightboxVisible\" class=\"lightbox\" @click.self=\"closeLightbox\">\n      <transition name=\"fade\">\n        <img v-if=\"selectedImage\" class=\"lightbox-content\" :src=\"selectedImage\" />\n      </transition>\n      <span class=\"close\" @click=\"closeLightbox\">&times;</span>\n    </div>\n\n    <transition name=\"fade-in-up\">\n      <button v-show=\"showScrollToTop\" class=\"scroll-to-top\" @click=\"scrollToTop\">\n        <v-icon>mdi-arrow-up</v-icon>\n      </button>\n    </transition>\n  </div>\n</template>\n\n<script setup>\nimport { ref, computed, onMounted, onUnmounted } from 'vue'\n\nconst currentPage = ref('portfolio');\n\nconst changePage = (page) => {\n  currentPage.value = page;\n  closeNav();\n  scrollToTop();\n};\n\nconst filters = ref([\n  { name: 'All', id: 'all' },\n  { name: 'Digital Art', id: 'digital-art' },\n  { name: 'Sketchbook', id: 'sketchbook' },\n  {\n    name: 'Graphic Design',\n    id: 'graphic-design',\n    subcategories: [\n      { name: 'Logos & Icons', id: 'logos-icons' },\n      { name: 'Emojis', id: 'emojis' },\n      { name: 'Promo Materials', id: 'promo-materials' }\n    ]\n  },\n  {\n    name: 'Animations',\n    id: 'animations',\n    subcategories: [\n      { name: 'Frame by Frame', id: 'frame-by-frame' },\n      { name: 'Loops & Shorts', id: 'loops-shorts' },\n      { name: 'Timelapse & Process', id: 'timelapse-process' }\n    ]\n  },\n  {\n    name: 'NFT Projects',\n    id: 'nft-projects',\n    subcategories: [\n      { name: 'Character Design', id: 'character-design' },\n      { name: 'Accessories & Traits', id: 'accessories-traits' },\n      { name: '1/1 Artworks', id: '1-1-artworks' }\n    ]\n  },\n  { name: 'Commissions', id: 'commissions' }\n]);\n\nconst activeFilter = ref(filters.value[0]);\nconst parentFilter = ref(null);\n\nconst currentFilters = computed(() => {\n  return parentFilter.value ? parentFilter.value.subcategories : filters.value;\n});\n\nconst selectFilter = (filter) => {\n  if (filter.subcategories) {\n    parentFilter.value = filter;\n  }\n  activeFilter.value = filter;\n};\n\nconst goBack = () => {\n  parentFilter.value = null;\n  activeFilter.value = filters.value[0];\n};\n\nconst images = ref([\n  { src: 'https://picsum.photos/seed/a1/400/500?lock=1', alt: 'Artwork A1', tag: 'digital-art', loaded: false },\n  { src: 'https://picsum.photos/seed/b2/500/300?lock=2', alt: 'Artwork B2', tag: 'logos-icons', loaded: false },\n  { src: 'https://picsum.photos/seed/c3/400/600?lock=3', alt: 'Artwork C3', tag: 'emojis', loaded: false },\n  { src: 'https://picsum.photos/seed/d4/600/400?lock=4', alt: 'Artwork D4', tag: 'promo-materials', loaded: false },\n  { src: 'https://picsum.photos/seed/e5/350/450?lock=5', alt: 'Artwork E5', tag: 'frame-by-frame', loaded: false },\n  { src: 'https://picsum.photos/seed/f6/500/700?lock=6', alt: 'Artwork F6', tag: 'loops-shorts', loaded: false },\n  { src: 'https://picsum.photos/seed/g7/400/550?lock=7', alt: 'Artwork G7', tag: 'timelapse-process', loaded: false },\n  { src: 'https://picsum.photos/seed/h8/450/400?lock=8', alt: 'Artwork H8', tag: 'character-design', loaded: false },\n  { src: 'https://picsum.photos/seed/i9/500/600?lock=9', alt: 'Artwork I9', tag: 'accessories-traits', loaded: false },\n  { src: 'https://picsum.photos/seed/j10/400/500?lock=10', alt: 'Artwork J10', tag: '1-1-artworks', loaded: false },\n  { src: 'https://picsum.photos/seed/k11/550/450?lock=11', alt: 'Artwork K11', tag: 'commissions', loaded: false },\n  { src: 'https://picsum.photos/seed/l12/400/700?lock=12', alt: 'Artwork L12', tag: 'digital-art', loaded: false },\n  { src: 'https://picsum.photos/seed/m13/600/350?lock=13', alt: 'Artwork M13', tag: 'sketchbook', loaded: false },\n  { src: 'https://picsum.photos/seed/n14/500/500?lock=14', alt: 'Artwork N14', tag: 'logos-icons', loaded: false },\n  { src: 'https://picsum.photos/seed/o15/450/550?lock=15', alt: 'Artwork O15', tag: 'emojis', loaded: false },\n]);\n\nconst filteredImages = computed(() => {\n  if (activeFilter.value.id === 'all') {\n    return images.value;\n  }\n  if (activeFilter.value.subcategories) {\n    const subFilterIds = activeFilter.value.subcategories.map(sf => sf.id);\n    return images.value.filter(img => subFilterIds.includes(img.tag));\n  } else {\n    return images.value.filter(img => img.tag === activeFilter.value.id);\n  }\n});\n\nconst lightboxVisible = ref(false)\nconst selectedImage = ref('')\n\nconst openLightbox = (src) => {\n  selectedImage.value = src\n  lightboxVisible.value = true\n}\n\nconst closeLightbox = () => {\n  selectedImage.value = ''\n  lightboxVisible.value = false\n}\n\nconst navOpen = ref(false)\nconst toggleNav = () => {\n  navOpen.value = !navOpen.value\n}\nconst closeNav = () => {\n  navOpen.value = false\n}\n\nconst showScrollToTop = ref(false);\n\nconst handleScroll = () => {\n  showScrollToTop.value = window.scrollY > 300;\n};\n\nconst scrollToTop = () => {\n  window.scrollTo({ top: 0, behavior: 'smooth' });\n};\n\nconst submitForm = () => {\n  // Qui puoi aggiungere la logica per l'invio del modulo\n  // ad esempio, usando fetch() o axios per inviare i dati a un'API\n  alert('Form inviato con successo!');\n};\n\nonMounted(() => {\n  window.addEventListener('scroll', handleScroll);\n});\n\nonUnmounted(() => {\n  window.removeEventListener('scroll', handleScroll);\n});\n</script>\n\n<style scoped=\"scss\">\n\n$pink-color: #c6538c;\n\n.portfolio-container {\n  font-family: 'Inter', sans-serif;\n  background-color: #f8f8f8;\n  color: #333;\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  overflow-x: hidden;\n}\n\nheader,\nfooter {\n  text-align: center;\n  padding: 1.5em;\n  background: rgba(255, 255, 255, 0.6);\n  backdrop-filter: blur(12px);\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n  border: 1px solid rgba(255, 255, 255, 0.3);\n  margin-bottom: 1rem;\n}\n\n/* Filter Bar */\n.filter-bar {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 1rem;\n  margin-top: 10px;\n  margin-bottom: 10px;\n}\n\n.filter-bar button {\n  background: none;\n  border: none;\n  font-size: 1rem;\n  color: #555;\n  cursor: pointer;\n  padding: 4px 10px;\n  position: relative;\n  transition: color 0.3s ease;\n}\n\n.filter-bar button.active {\n  color: #ff69b4;\n  font-weight: bold;\n}\n\n.filter-bar button.active::after {\n  content: '';\n  position: absolute;\n  height: 2px;\n  width: 100%;\n  left: 0;\n  bottom: -4px;\n  background-color: #ff69b4;\n  border-radius: 2px;\n}\n\n.back-button {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-size: 1rem;\n  font-weight: bold;\n  color: #555;\n  transition: color 0.3s ease;\n}\n\n.back-button:hover {\n  color: #ff69b4;\n}\n\n.back-arrow {\n  font-size: 1.5rem;\n  line-height: 1;\n}\n\n/* Masonry Grid */\n.masonry-grid {\n  column-count: 3;\n  column-gap: 1.5rem;\n  padding: 30px;\n}\n\n@media (max-width: 900px) {\n  .masonry-grid {\n    column-count: 2;\n  }\n}\n\n@media (max-width: 600px) {\n  .masonry-grid {\n    column-count: 1;\n  }\n}\n\n.masonry-item {\n  margin-bottom: 1.5rem;\n  break-inside: avoid;\n}\n\n.image-wrapper {\n  position: relative;\n  overflow: hidden;\n  border-radius: 16px;\n  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);\n  cursor: pointer;\n  background: rgba(255, 255, 255, 0.2);\n  backdrop-filter: blur(10px);\n  border: 1px solid rgba(255, 255, 255, 0.4);\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\n}\n\n.image-wrapper:hover {\n  transform: scale(1.02);\n  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.15);\n}\n\n.image-wrapper img {\n  width: 100%;\n  height: auto;\n  display: block;\n  border-radius: 16px;\n  opacity: 0;\n  transform: scale(1.05);\n  filter: blur(12px);\n  transition: all 0.6s ease;\n}\n\n.image-wrapper img.loaded {\n  opacity: 1;\n  transform: scale(1);\n  filter: blur(0);\n}\n\n.overlay {\n  position: absolute;\n  inset: 0;\n  background: rgba(255, 255, 255, 0.15);\n  backdrop-filter: blur(8px);\n  opacity: 0;\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n  padding: 1rem;\n  color: #fff;\n  font-size: 1rem;\n  font-weight: 500;\n  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.5);\n  border-radius: 16px;\n  transition: opacity 0.3s ease;\n}\n\n.image-wrapper:hover .overlay {\n  opacity: 1;\n}\n\n.lightbox {\n  position: fixed;\n  z-index: 999;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: rgba(20, 20, 20, 0.5);\n  backdrop-filter: blur(12px);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  padding: 30px;\n}\n\n.lightbox-content {\n  max-width: 95%;\n  max-height: 90%;\n  border-radius: 16px;\n  box-shadow: 0 0 40px rgba(0, 0, 0, 0.6);\n  border: 1px solid rgba(255, 255, 255, 0.25);\n}\n\n.close {\n  position: fixed;\n  top: 20px;\n  right: 30px;\n  color: #fff;\n  font-size: 36px;\n  font-weight: bold;\n  cursor: pointer;\n  z-index: 1000;\n  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);\n}\n\n.fade-enter-active,\n.fade-leave-active {\n  tr