  <h2 class=\"text mb-4\">Affordable Excellence</h2>\n        <h3 id=\"descr-text\" class=\"text\">Our system delivers high-quality 3D scans at a fraction of the cost, being 10x\n          more affordable than\n          competitors.\n          With few RGB-D cameras, we create lifelike 3D avatars that combine photorealism\n          and precise anthropometric measurements with exceptional efficiency. </h3>\n\n        <div id=\"icon-container\" class=\"d-flex flex-row justify-space-around mt-16\">\n          <div class=\"div-icons flex-column text-center\">\n            <b-icon icon=\"clock\" font-scale=\"3\" class=\"text\"></b-icon>\n            <div class=\"text text-h5 mt-3\">Instant scan</div>\n          </div>\n          <div class=\"div-icons flex-column text-center\">\n            <b-icon icon=\"currency-euro\" font-scale=\"3\" class=\"text\"></b-icon>\n            <div class=\"text text-h5 mt-3\">Low cost</div>\n          </div>\n          <div class=\"div-icons flex-column text-center\">\n            <b-icon icon=\"box\" font-scale=\"3\" class=\"text\"></b-icon>\n            <div class=\"text text-h5 mt-3\">3x3x3 meters</div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n  </div>\n</template>\n\n<script setup>\n\n</script>\n\n<style scoped>\n#root-container {\n  background: #666666;\n  padding: 4% 8% 4% 8%;\n  margin-top: 6%;\n  border-radius: 25px;\n}\n\n#description-container {\n  padding: 8% 0 8% 20%;\n}\n\n.text {\n  color: white;\n}\n\n#descr-text {\n  color: black;\n}\n\nh1 {\n  text-align: right;\n}\n\nh3 {\n  margin-top: 8%;\n}\n\n#contents {\n  margin-top: 2.5%;\n}\n\n@media screen and (max-width: 600px) {\n  #description-container {\n    text-align: center !important;\n  }\n\n  h3 {\n    margin-top: 3%;\n  }\n\n  #icon-container {\n    flex-direction: column !important;\n    justify-content: center !important;\n    //flex-grow: 2rem;\n    flex-wrap: wrap !important;\n    flex-basis: 10% !important;\n  }\n\n  .div-icons {\n    margin-bottom: 10%;\n  }\n\n}\n\n/* Large devices (laptops/desktops, 992px and up) */\n@media only screen and (min-width: 992px) {\n  #image-scanner {\n    width: 350px;\n  }\n\n  .text {\n    text-align: center;\n  }\n}\n\n@media screen and (max-width: 1034px) {\n  .text {\n    text-align: center;\n  }\n\n  #contents {\n    flex-direction: column;\n    justify-content: center;\n    //flex-grow: 2rem;\n    flex-wrap: wrap;\n    flex-basis: 10%;\n  }\n\n  #description-container {\n    max-width: 100%;\n    height: auto;\n    padding: 5% 0 5% 0;\n  }\n\n  #image-scanner {\n    width: 250px;\n  }\n}\n\n\n/* Extra large devices (large laptops and desktops, 1200px and up) */\n@media only screen and (min-width: 1200px) {\n  #image-scanner {\n    width: 350px;\n  }\n\n  .text {\n    text-align: right;\n    font-size: 2.3em;\n  }\n}\n\n@media only screen and (min-width: 2000px) {\n  #image-scanner {\n    width: 450px;\n  }\n\n}\n\n\n</style>"]}]}