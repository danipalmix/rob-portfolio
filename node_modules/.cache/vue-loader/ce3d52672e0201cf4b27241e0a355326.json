{"remainingRequest":"/Users/vincenzo/Projects/rob-portfolio/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/vincenzo/Projects/rob-portfolio/src/components/EffingoContainerSmallCard.vue?vue&type=style&index=0&id=0e372708&scoped=true&lang=css","dependencies":[{"path":"/Users/vincenzo/Projects/rob-portfolio/src/components/EffingoContainerSmallCard.vue","mtime":1761067797681},{"path":"/Users/vincenzo/Projects/rob-portfolio/node_modules/css-loader/dist/cjs.js","mtime":1740835932650},{"path":"/Users/vincenzo/Projects/rob-portfolio/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1740835923854},{"path":"/Users/vincenzo/Projects/rob-portfolio/node_modules/postcss-loader/src/index.js","mtime":1740835923396},{"path":"/Users/vincenzo/Projects/rob-portfolio/node_modules/cache-loader/dist/cjs.js","mtime":1740835932768},{"path":"/Users/vincenzo/Projects/rob-portfolio/node_modules/vue-loader/lib/index.js","mtime":1740835923805}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:Ci52LXBhcmFsbGF4X19pbWFnZSB7CiAgaGVpZ2h0OiAxMDAlICFpbXBvcnRhbnQ7Cn0KCi5jYXJkLWNvbnRhaW5lciB7CiAgbWFyZ2luLXRvcDogNiU7Cn0K"},{"version":3,"sources":["EffingoContainerSmallCard.vue"],"names":[],"mappings":";AAsEA;AACA;AACA;;AAEA;AACA;AACA","file":"EffingoContainerSmallCard.vue","sourceRoot":"src/components","sourcesContent":["<template>\n  <div class=\"card-container\">\n    <b-row>\n      <b-col\n          v-for=\"(feature, index) in listOfFeature\"\n          :key=\"index\"\n          class=\"col mx-auto my-10 my-sm-1 my-xs-1\"\n          :class=\"{'is-visible': isVisible}\"\n          :style=\"{ 'transition-delay': `${index * 0.6}s` }\"\n      >\n        <SmallCard\n            :isMobile=\"isMobile\"\n            :isVisible=\"isVisible\"\n            :index=\"index\"\n            :icon=\"feature.icon\"\n            :title=\"feature.title\"\n            :description=\"feature.description\"\n        ></SmallCard>\n      </b-col>\n    </b-row>\n  </div>\n</template>\n\n<script setup>\nimport {ref, onMounted} from 'vue';\nimport SmallCard from \"@/components/SmallCard.vue\";\n\n// Define props directly in <script setup>\nconst props = defineProps({\n  listOfFeature: Array,\n  isMobile: Boolean\n});\n\n// Define isVisible using `ref` to make it reactive\nconst isVisible = ref(false);\n\n// IntersectionObserver logic inside `onMounted` (Composition API equivalent of mounted)\nonMounted(() => {\n  // Function to determine device type or screen size\n  const isMobile = window.innerWidth <= 768; // Adjust this breakpoint as needed\n  const isTablet = window.innerWidth > 768 && window.innerWidth <= 1024;\n\n  // Set the threshold based on device type\n  let threshold = 0.5; // Default for desktop\n  if (isMobile) {\n    threshold = 0.2; // Less threshold for mobile\n  } else if (isTablet) {\n    threshold = 0.3; // Adjust for tablet\n  }\n\n  const observer = new IntersectionObserver((entries) => {\n    entries.forEach((entry) => {\n      if (entry.isIntersecting) {\n        isVisible.value = true; // Update reactive isVisible to trigger reactivity\n        observer.unobserve(entry.target); // Stop observing once it's visible\n      }\n    });\n  }, {\n    threshold: threshold, // Trigger when 50% of the element is visible\n    rootMargin: '0px 0px -100px 0px' // Adjust the margin to trigger earlier/later\n  });\n\n  // Observe the parallax container\n  // observer.observe(document.querySelector('.v-parallax'));\n  observer.observe(document.querySelector('.card-container'));\n});\n</script>\n\n\n<style scoped>\n.v-parallax__image {\n  height: 100% !important;\n}\n\n.card-container {\n  margin-top: 6%;\n}\n</style>"]}]}