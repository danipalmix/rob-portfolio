>\n          <!-- Primary Button -->\n          <a\n              v-if=\"card.ctaText\"\n              class=\"effingo-card-btn primary-btn\"\n              :href=\"card.ctaLink || '#'\"\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n          >\n            {{ card.ctaText }}\n          </a>\n\n          <!-- Secondary Button (optional) -->\n          <a\n              v-if=\"card.extraButtonText\"\n              class=\"effingo-card-btn secondary-btn\"\n              :href=\"card.extraButtonLink || '#'\"\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n          >\n            {{ card.extraButtonText }}\n          </a>\n        </div>\n      </div>\n\n      <!-- Image Section -->\n      <div class=\"effingo-card-image\">\n        <img :src=\"card.imageUrl\" alt=\"Card Image\" />\n      </div>\n    </div>\n  </div>\n</template>\n\n<style scoped>\n/* Container for all cards */\n.effingo-cards-container {\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem; /* spacing between cards */\n  margin: 2rem auto;\n  max-width: 1200px; /* adjust as needed */\n  padding: 0 1rem;   /* side padding */\n}\n\n/* Each card wrapper */\n.effingo-card {\n  display: flex;\n  flex-wrap: wrap; /* allow wrapping on smaller screens */\n  background-color: #1f1f1f;\n  border-radius: 10px;\n  overflow: hidden;\n  align-items: center;\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3); /* slight depth effect */\n}\n\n/* Text side */\n.effingo-card-content {\n  flex: 1 1 400px; /* ensure at least 400px width on larger screens */\n  padding: 2rem;\n  color: #f8f8f8;\n}\n\n/* Title */\n.effingo-card-title {\n  font-size: 1.8rem;\n  font-weight: 700;\n  margin-bottom: 0.5rem;\n  color: #fff;\n}\n\n/* Optional subtitle */\n.effingo-card-subtitle {\n  font-size: 1rem;\n  color: #999;\n  margin-bottom: 1rem;\n}\n\n/* Description */\n.effingo-card-description {\n  font-size: 1rem;\n  line-height: 1.5;\n  margin-bottom: 1rem;\n}\n\n/* Buttons container */\n.effingo-card-buttons {\n  display: flex;\n  gap: 1rem;\n  margin-top: 1rem;\n}\n\n/* Shared button styles */\n.effingo-card-btn {\n  text-decoration: none;\n  padding: 0.8rem 1.2rem;\n  border-radius: 6px;\n  font-weight: 600;\n  text-align: center;\n  transition: background-color 0.3s ease, color 0.3s ease;\n}\n\n/* Primary CTA styling */\n.primary-btn {\n  background-color: #10bccd; /* adapt color as needed */\n  color: #fff;\n}\n\n.primary-btn:hover {\n  background-color: #0ca5b3;\n}\n\n/* Secondary CTA styling */\n.secondary-btn {\n  background-color: #333;\n  color: #fff;\n}\n\n.secondary-btn:hover {\n  background-color: #444;\n}\n\n/* Image side */\n.effingo-card-image {\n  flex: 1 1 300px; /* at least 300px on larger screens */\n  text-align: center;\n  padding: 1rem;\n}\n\n.effingo-card-image img {\n  width: 100%;\n  height: auto;\n  object-fit: cover;\n  max-width: 400px; /* optional max width */\n  border-radius: 8px;\n}\n\n/* Responsive breakpoints */\n@media (max-width: 768px) {\n  .effingo-card {\n    flex-direction: column;\n  }\n  .effingo-card-content,\n  .effingo-card-image {\n    flex: 1 1 100%;\n    padding: 1rem;\n  }\n  .effingo-card-image img {\n    max-width: 100%;\n  }\n}\n</style>\n"],"names":[],"mappings":";AACA,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;AAC9B;AACA,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;AAC3C,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;AACvB,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;AAClB,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC;AACtB,CAAC,CAAC,C