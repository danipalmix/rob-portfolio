{"remainingRequest":"/Users/vincenzo/Projects/rob-portfolio/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/vincenzo/Projects/rob-portfolio/src/components/EffingoCards.vue?vue&type=style&index=0&id=fc4fcffe&scoped=true&lang=css","dependencies":[{"path":"/Users/vincenzo/Projects/rob-portfolio/src/components/EffingoCards.vue","mtime":1761067797656},{"path":"/Users/vincenzo/Projects/rob-portfolio/node_modules/css-loader/dist/cjs.js","mtime":1740835932650},{"path":"/Users/vincenzo/Projects/rob-portfolio/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1740835923854},{"path":"/Users/vincenzo/Projects/rob-portfolio/node_modules/postcss-loader/src/index.js","mtime":1740835923396},{"path":"/Users/vincenzo/Projects/rob-portfolio/node_modules/cache-loader/dist/cjs.js","mtime":1740835932768},{"path":"/Users/vincenzo/Projects/rob-portfolio/node_modules/vue-loader/lib/index.js","mtime":1740835923805}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["EffingoCards.vue"],"names":[],"mappings":";AAmDA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA","file":"EffingoCards.vue","sourceRoot":"src/components","sourcesContent":["<template>\n  <div class=\"effingo-cards-container\">\n    <div\n        v-for=\"(card, index) in sortedCards\"\n        :key=\"index\"\n        class=\"effingo-card\"\n        :class=\"getCardClass(index)\"\n        @mousemove=\"handleMouseMove\"\n    >\n      <!-- Text Section -->\n      <div class=\"effingo-card-content\">\n        <h3 class=\"effingo-card-title\">{{ card.title }}</h3>\n        <p v-if=\"card.subtitle\" class=\"effingo-card-subtitle\">\n          {{ card.subtitle }}\n        </p>\n        <p class=\"effingo-card-description\">{{ card.description }}</p>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"EffingoCards\",\n  props: {\n    cards: {\n      type: Array,\n      required: true\n    }\n  },\n  computed: {\n    sortedCards() {\n      return this.cards;\n    }\n  },\n  methods: {\n    handleMouseMove(e) {\n      const rect = e.currentTarget.getBoundingClientRect();\n      const x = e.clientX - rect.left;\n      const y = e.clientY - rect.top;\n      e.currentTarget.style.setProperty('--mouse-x', `${x}px`);\n      e.currentTarget.style.setProperty('--mouse-y', `${y}px`);\n    },\n    getCardClass(index) {\n      return `card-${index + 1}`;\n    }\n  }\n};\n</script>\n\n<style scoped>\n/* Container for all cards */\n.effingo-cards-container {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin: 2rem auto;\n  //max-width: 1280px;\n  //padding: 0 1rem;\n  justify-content: center;\n}\n\n/* Each card */\n.effingo-card {\n  background-color: rgba(10, 10, 11, 0.2);\n  border-radius: 10px;\n  padding: 1.5rem;\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\n  text-align: center;\n  min-height: 150px;\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-grow: 1;\n  overflow: hidden;\n}\n\n/* Scale and shadow on hover */\n.effingo-card:hover {\n  transform: scale(1.02);\n  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.5);\n}\n\n/* Pseudo-element for the hover radial gradient */\n.effingo-card::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  border-radius: inherit;\n  pointer-events: none;\n  background: radial-gradient(\n      800px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),\n      rgba(255, 255, 255, 0.06),\n      transparent 40%\n  );\n  opacity: 0;\n  transition: opacity 0.5s;\n  z-index: 2;\n}\n\n/* Reveal the gradient on hover */\n.effingo-card:hover::before {\n  opacity: 1;\n}\n\n/* Card Content */\n.effingo-card-content {\n  color: #f8f8f8;\n  position: relative;\n  z-index: 3;\n}\n\n/* Title */\n.effingo-card-title {\n  font-size: 1.5rem;\n  font-weight: 700;\n  color: #fff;\n}\n\n/* Subtitle */\n.effingo-card-subtitle {\n  font-size: 1rem;\n  color: #999;\n  margin-bottom: 0.5rem;\n}\n\n/* Description */\n.effingo-card-description {\n  font-size: 1rem;\n  line-height: 1.5;\n}\n\n/* Layout based on the provided image */\n.card-1 {\n  flex-basis: 60%;\n}\n.card-2, .card-3 {\n  flex-basis: 20%;\n}\n.card-4, .card-6 {\n  flex-basis: 30%;\n}\n.card-5 {\n  flex-basis: 40%;\n}\n.card-7 {\n  flex-basis: 50%;\n}\n.card-8, .card-9 {\n  flex-basis: 25%;\n}\n\n/* Responsive Design */\n@media (max-width: 1024px) {\n  .effingo-cards-container {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 10px;\n  }\n  .effingo-card {\n    flex-basis: 100%;\n  }\n}\n\n@media (max-width: 768px) {\n  .effingo-cards-container {\n    grid-template-columns: 1fr;\n  }\n}\n</style>\n"]}]}